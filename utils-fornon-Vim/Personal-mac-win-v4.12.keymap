            bindings = <
              &kp ESC  &kp N1  &kp N2  &kp N3              &kp N4  &kp N5                                                                                                                       &kp N6              &kp N7  &kp N8  &kp N9  &kp N0  &kp BSPC
               &trans   &kp Q   &kp W   &kp E               &kp R   &kp T                                                                                                                        &kp Y               &kp U   &kp I   &kp O   &kp P  &kp BSPC
               &trans   &kp A   &kp S   &kp D               &kp F   &kp G                                                                                                                        &kp H               &kp J   &kp K   &kp L  &trans    &trans
 &magic LAYER_Magic 0   &kp Z   &kp X   &kp C  &index_tab LSHFT V   &kp B                                                                                                                        &kp N  &index_tab RSHFT M  &trans  &trans  &trans    &trans
                               &trans  &trans              &trans                                                                                                                                                 &kp RGUI  &trans  &trans
                                                                           &kp LCTRL  &thumb_layer_space LAYER_nav_win SPACE  &kp SPACE  &trans  &thumb_layer_enter LAYER_symbol RET  &kp RALT
            >;
        };

        layer_typing {
            bindings = <
 &trans  &trans  &trans  &trans  &trans  &trans                                                  &trans     &trans  &trans  &trans  &trans  &trans
 &trans  &trans  &trans  &trans  &trans  &trans                                                  &trans     &trans  &trans  &trans  &trans  &trans
 &trans  &trans  &trans  &trans  &trans  &trans                                                  &trans     &trans  &trans  &trans  &trans  &trans
 &trans  &trans  &trans  &trans   &kp V  &trans                                                  &trans      &kp M  &trans  &trans  &trans  &trans
                 &trans  &trans  &trans                                                                  &kp RSHFT  &trans  &trans
                                                 &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_symbol {
            bindings = <
              &kp ESC      &trans      &trans      &trans      &trans      &trans                                                              &trans         &trans        &trans        &trans        &trans         &trans
               &trans  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                                                          &kp LS(N6)     &kp LS(N7)    &kp LS(N8)    &kp LS(N9)    &kp LS(N0)         &trans
               &trans      &kp N1      &kp N2      &kp N3      &kp N4      &kp N5                                                           &kp MINUS      &kp EQUAL  &kp LS(LBKT)  &kp LS(RBKT)  &kp LS(BSLH)      &kp GRAVE
 &magic LAYER_Magic 0      &kp N6      &kp N7      &kp N8      &kp N9      &kp N0                                                       &kp LS(MINUS)  &kp LS(EQUAL)      &kp LBKT      &kp RBKT      &kp BSLH  &kp LS(GRAVE)
                                        &none      &trans      &trans                                                                                         &trans        &trans        &trans
                                                                                   &trans  &kp SPACE  &trans  &trans  &trans  &kp RALT
            >;
        };

        layer_nav_mac {
            bindings = <
              &kp ESC  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                                                      &kp LS(N6)     &kp LS(N7)       &kp LS(N8)   &kp LS(N9)    &kp LS(N0)     &trans
               &trans      &kp N1      &kp N2      &kp N3      &kp N4      &kp N5                                                          &kp N6         &kp N7           &kp N8       &kp N9        &kp N0     &trans
               &trans   &kp LG(A)   &kp LG(S)   &kp LS(D)   &kp LG(F)   &kp PG_UP                                                        &kp LEFT       &kp DOWN           &kp UP    &kp RIGHT  &kp LS(BSLH)  &kp GRAVE
 &magic LAYER_Magic 0   &kp LG(Z)   &kp LG(X)   &kp LC(C)   &kp LG(V)   &kp PG_DN                                                   &kp LS(MINUS)  &kp LS(EQUAL)         &kp LBKT     &kp RBKT        &trans     &trans
                                       &trans      &trans      &trans                                                                                     &trans  &kp LC(LS(TAB))  &kp LC(TAB)
                                                                                   &trans  &trans  &trans  &trans  &kp RET  &trans
            >;
        };

        layer_nav_win {
            bindings = <
              &kp ESC  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)     &kp LS(N4)  &kp LS(N5)                                                      &kp LS(N6)     &kp LS(N7)       &kp LS(N8)   &kp LS(N9)    &kp LS(N0)     &trans
               &trans      &kp N1      &kp N2      &kp N3         &kp N4      &kp N5                                                          &kp N6         &kp N7           &kp N8       &kp N9        &kp N0     &trans
               &trans   &kp LC(A)   &kp LC(S)   &kp LG(D)      &kp LC(F)   &kp PG_UP                                                        &kp LEFT       &kp DOWN           &kp UP    &kp RIGHT  &kp LS(BSLH)  &kp GRAVE
 &magic LAYER_Magic 0   &kp LC(Z)   &kp LC(X)   &kp LC(C)  &kp LC(LS(V))   &kp PG_DN                                                   &kp LS(MINUS)  &kp LS(EQUAL)         &kp LBKT     &kp RBKT        &trans     &trans
                                       &trans      &trans         &trans                                                                                     &trans  &kp LC(LS(TAB))  &kp LC(TAB)
                                                                                      &trans  &trans  &trans  &trans  &kp RET  &trans
            >;
        };

        layer_mouse {
            bindings = <
 &trans  &trans     &trans     &trans     &trans  &trans                                                                &trans            &trans             &trans            &trans  &trans    &trans
 &trans  &trans     &trans     &trans     &trans  &trans                                                      &msc MOVE_X(-20)  &msc MOVE_Y(-30)    &msc MOVE_Y(30)   &msc MOVE_X(20)  &trans    &trans
 &trans  &trans     &trans     &trans     &trans  &trans                                                     &mmv MOVE_X(-900)  &mmv MOVE_Y(900)  &mmv MOVE_Y(-900)  &mmv MOVE_X(900)  &trans  &mkp MB5
 &trans  &trans  &kp LG(X)  &kp LG(C)  &kp LG(V)  &trans                                                                &trans         &mkp LCLK          &mkp RCLK            &trans  &trans  &mkp MB4
                    &trans     &trans     &trans                                                                                          &trans             &trans            &trans
                                                          &trans  &trans  &trans  &trans  &trans  &mkp LCLK
            >;
        };

        layer_functions {
            bindings = <
 &trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                                                  &kp F6     &kp F7     &kp F8     &kp F9  &kp F10  &kp F11
 &trans  &trans  &trans  &trans  &trans  &trans                                                  &trans     &trans     &trans     &trans   &trans  &kp F12
 &trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &kp LANG1  &kp LANG2  &kp LANG3   &trans   &trans
 &trans  &trans  &trans  &trans  &trans  &trans                                                  &trans     &trans     &trans     &trans   &trans   &trans
                 &trans  &trans  &trans                                                                     &trans     &trans     &trans
                                                 &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_Magic {
            bindings = <
  &bt BT_CLR     &kp C_BRI_DN     &kp C_BRI_UP       &kp C_PREV        &kp C_NEXT         &kp C_PP                                                                                                                                   &kp C_MUTE     &kp C_VOL_DN  &kp C_VOL_UP      &none   &none     &bt BT_CLR_ALL
 &bootloader  &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI   &rgb_ug RGB_BRI  &rgb_ug RGB_TOG                                                                                                                                        &none            &none         &none      &none   &none        &bootloader
  &sys_reset  &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD   &rgb_ug RGB_BRD  &rgb_ug RGB_EFF                                                                                                                                        &none        &kp LANG1     &kp LANG2  &kp LANG3   &none         &sys_reset
       &none            &none            &bt_0            &bt_1             &bt_2            &bt_3                                                                                                                          &to LAYER_functions  &to LAYER_mouse         &none      &none   &none  &to LAYER_Factory
                                  &out OUT_USB            &none  &to LAYER_typing                                                                                                                                                                          &none         &none      &none
                                                                                                    &to LAYER_Base_mac  &to LAYER_Base_win  &to LAYER_Base_mac  &to LAYER_Base_mac  &to LAYER_Base_win  &to LAYER_Base_mac
            >;
        };

        layer_Factory {
            bindings = <
 &kp N0  &kp N4  &kp N8  &kp N3  &kp N8  &kp N3                                                  &kp N3  &kp N8  &kp N3  &kp N8  &kp N4  &kp N0
 &kp N1  &kp N5  &kp N9  &kp N4  &kp N9  &kp N4                                                  &kp N4  &kp N9  &kp N4  &kp N9  &kp N5  &kp N1
 &kp N2  &kp N6  &kp N0  &kp N5  &kp N0  &kp N5                                                  &kp N5  &kp N0  &kp N5  &kp N0  &kp N6  &kp N2
 &kp N3  &kp N7  &kp N1  &kp N6  &kp N1  &kp N6                                                  &kp N6  &kp N1  &kp N6  &kp N1  &kp N7  &kp N3
                 &kp N2  &kp N7  &kp N2                                                                  &kp N2  &kp N7  &kp N2
                                                 &kp N7  &kp N8  &kp N9  &kp N9  &kp N8  &kp N7
            >;
        };

    };
};
