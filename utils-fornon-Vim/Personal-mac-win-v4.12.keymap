            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            quick-tap-ms = <300>;
        };

        // thumb layers change
        thumb_layer_space: thumb_layer_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
